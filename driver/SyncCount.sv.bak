module SyncCount(
	input logic enable_n,
	output logic hsync,
	output logic vsync
);

// Horizontal, low for 160 high for 640
// Vertical, high for low for 45 high for 480

logic [7:0] h_counter;
logic [7:0] v_counter;

always_ff @(posedge enable_n) begin
	
	// Horizontal
	if (h_counter == 160) begin
		hsync <= 1;
		h_counter <= h_counter + 1;
	end
	else if (h_counter == 800) begin
		hsync <= 0;
		h_counter <= 8'b0;
	end
	else begin 
		h_counter <= h_counter + 1;
		hsync <= hsync;
	end
	
	// Vertical
	if (v_counter == 45) begin 
		vsync <= 1;
		v_counter <= v_counter + 1;
	end
	else if (v_counter == 525) begin 
		vsync <= 0;
		v_counter <= 8'b0;
	end
	else begin 
		v_counter <= v_counter + 1;
		vsync <= vsync;
	end
		
end

endmodule
	